{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": ".",
  "git": {"deploymentEnabled":{"main":true}},
  "github": {"enabled":true},
  "crons": [{"path":"/api/cron/integration-sync","schedule":"0 3 * * *"}],
  "functions": {
    "api/admin-ai-agent.js":{"maxDuration":120,"memory":1024},
    "api/admin-ai-isolated.js":{"maxDuration":120,"memory":1024},
    "api/import-site.js":{"maxDuration":60,"memory":1024},
    "api/import-ai.js":{"maxDuration":120,"memory":1024},
    "api/cron.js":{"maxDuration":60,"memory":1024},
    "api/integrations.js":{"maxDuration":60,"memory":1024},
    "api/payments.js":{"maxDuration":60,"memory":1024}
  },
  "rewrites": [
    {"source":"/","destination":"/src/pages/guest/index.html"},
    {"source":"/favicon.ico","destination":"/src/assets/icons/favicon.svg"},
    {"source":"/api/admin-ai-audit","destination":"/api/admin-ai-isolated"},
    {"source":"/api/menu/import","destination":"/api/import-ai"},
    {"source":"/api/manager-ai","destination":"/api/manager-ai-propose"},
    {"source":"/api/integrations/:path*","destination":"/api/integrations?route=/api/integrations/:path*"},
    {"source":"/api/payments/yookassa/:path*","destination":"/api/payments"},
    {"source":"/api/cron/integration-sync","destination":"/api/cron"},
    {"source":"/recipe-images/:slug*","destination":"https://theunitools.com/recipes/:slug*"},
    {"source":"/index.html","destination":"/src/pages/guest/index.html"},
    {"source":"/menu.html","destination":"/src/pages/guest/menu.html"},
    {"source":"/menu-v2.html","destination":"/src/pages/guest/menu-v2.html"},
    {"source":"/venues.html","destination":"/src/pages/guest/venues.html"},
    {"source":"/waiter.html","destination":"/src/pages/staff/waiter.html"},
    {"source":"/cook.html","destination":"/src/pages/staff/cook.html"},
    {"source":"/courier.html","destination":"/src/pages/staff/courier.html"},
    {"source":"/hall.html","destination":"/src/pages/staff/hall.html"},
    {"source":"/staff-history.html","destination":"/src/pages/staff/staff-history.html"},
    {"source":"/staff-table.html","destination":"/src/pages/staff/staff-table.html"},
    {"source":"/demo-staff.html","destination":"/src/pages/staff/demo-staff.html"},
    {"source":"/manager.html","destination":"/src/pages/manager/manager.html"},
    {"source":"/manager-demo.html","destination":"/src/pages/manager/manager-demo.html"},
    {"source":"/manager-staff-statistics.html","destination":"/src/pages/manager/manager-staff-statistics.html"},
    {"source":"/integrations.html","destination":"/src/pages/manager/integrations.html"},
    {"source":"/staff-guide.html","destination":"/src/pages/manager/staff-guide.html"},
    {"source":"/admin.html","destination":"/src/pages/admin/admin.html"},
    {"source":"/admin-analytics.html","destination":"/src/pages/admin/admin-analytics.html"},
    {"source":"/admin-permissions.html","destination":"/src/pages/admin/admin-permissions.html"},
    {"source":"/venue-analytics.html","destination":"/src/pages/admin/venue-analytics.html"},
    {"source":"/admin_templates.html","destination":"/src/pages/admin/admin_templates.html"},
    {"source":"/login.html","destination":"/src/pages/auth/login.html"},
    {"source":"/register.html","destination":"/src/pages/auth/register.html"},
    {"source":"/assets/:path*","destination":"/src/assets/:path*"},
    {"source":"/icons/:path*","destination":"/src/assets/icons/:path*"},
    {"source":"/img/:path*","destination":"/src/assets/img/:path*"},
    {"source":"/css/:path*","destination":"/src/assets/css/:path*"},
    {"source":"/js/app.js","destination":"/src/assets/js/shared/app.js"},
    {"source":"/js/config.js","destination":"/src/assets/js/shared/config.js"},
    {"source":"/js/offline-sync.js","destination":"/src/assets/js/shared/offline-sync.js"},
    {"source":"/js/design-runtime.js","destination":"/src/assets/js/guest/design-runtime.js"},
    {"source":"/js/staff-ui-patches.js","destination":"/src/assets/js/staff/staff-ui-patches.js"},
    {"source":"/js/demo-data.js","destination":"/src/assets/js/demo/demo-data.js"},
    {"source":"/js/demo-manager-create.js","destination":"/src/assets/js/demo/demo-manager-create.js"},
    {"source":"/js/demo-mode.js","destination":"/src/assets/js/demo/demo-mode.js"},
    {"source":"/js/demo-staff-v2.js","destination":"/src/assets/js/demo/demo-staff-v2.js"},
    {"source":"/js/integrations-hub.js","destination":"/src/assets/js/manager/integrations-hub.js"},
    {"source":"/js/qr-ai-assistant.js","destination":"/src/assets/js/manager/qr-ai-assistant.js"},
    {"source":"/js/manager-design.js","destination":"/src/assets/js/manager/manager-design.js"},
    {"source":"/js/manager-hall.js","destination":"/src/assets/js/manager/manager-hall.js"},
    {"source":"/js/manager-hall-ai.js","destination":"/src/assets/js/manager/manager-hall-ai.js"},
    {"source":"/js/manager-hall-view.js","destination":"/src/assets/js/manager/manager-hall-view.js"},
    {"source":"/js/manager-payment-settings.js","destination":"/src/assets/js/manager/manager-payment-settings.js"},
    {"source":"/js/manager-permissions-bridge.js","destination":"/src/assets/js/manager/manager-permissions-bridge.js"},
    {"source":"/js/manager-personnel-final.js","destination":"/src/assets/js/manager/manager-personnel-final.js"},
    {"source":"/js/manager-staff-quick-actions.js","destination":"/src/assets/js/manager/manager-staff-quick-actions.js"},
    {"source":"/js/manager-staff-statistics.js","destination":"/src/assets/js/manager/manager-staff-statistics.js"},
    {"source":"/js/manager-site-import.js","destination":"/src/assets/js/manager/manager-site-import.js"},
    {"source":"/js/manager-core.js","destination":"/src/assets/js/manager/manager-core.js"},
    {"source":"/js/manager-menu.js","destination":"/src/assets/js/manager/manager-menu.js"},
    {"source":"/js/manager-recipes.js","destination":"/src/assets/js/manager/manager-recipes.js"},
    {"source":"/js/manager-staff.js","destination":"/src/assets/js/manager/manager-staff.js"},
    {"source":"/js/manager-orders.js","destination":"/src/assets/js/manager/manager-orders.js"},
    {"source":"/js/manager-venues.js","destination":"/src/assets/js/manager/manager-venues.js"},
    {"source":"/js/manager-settings.js","destination":"/src/assets/js/manager/manager-settings.js"},
    {"source":"/js/manager-billing.js","destination":"/src/assets/js/manager/manager-billing.js"},
    {"source":"/js/manager-analytics.js","destination":"/src/assets/js/manager/manager-analytics.js"},
    {"source":"/js/manager-app.js","destination":"/src/assets/js/manager/manager-app.js"},
    {"source":"/js/manager-ai.js","destination":"/src/assets/js/manager/manager-ai.js"},
    {"source":"/js/:path*","destination":"/src/assets/js/:path*"},
    {"source":"/icon-courier-192.png","destination":"/src/assets/icons/icon-courier-192.png"},
    {"source":"/icon-courier-512.png","destination":"/src/assets/icons/icon-courier-512.png"},
    {"source":"/icon-manager-192.png","destination":"/src/assets/icons/icon-manager-192.png"},
    {"source":"/icon-manager-512.png","destination":"/src/assets/icons/icon-manager-512.png"},
    {"source":"/icon-waiter-192.png","destination":"/src/assets/icons/icon-waiter-192.png"},
    {"source":"/icon-waiter-512.png","destination":"/src/assets/icons/icon-waiter-512.png"},
    {"source":"/apple-touch-icon-courier.png","destination":"/src/assets/icons/apple-touch-icon-courier.png"},
    {"source":"/apple-touch-icon-manager.png","destination":"/src/assets/icons/apple-touch-icon-manager.png"},
    {"source":"/apple-touch-icon-waiter.png","destination":"/src/assets/icons/apple-touch-icon-waiter.png"},
    {"source":"/src/pages/:role/js/:path*","destination":"/src/assets/js/:path*"},
    {"source":"/src/pages/:role/css/:path*","destination":"/src/assets/css/:path*"},
    {"source":"/src/pages/:role/img/:path*","destination":"/src/assets/img/:path*"},
    {"source":"/src/pages/:role/icons/:path*","destination":"/src/assets/icons/:path*"},
    {"source":"/src/pages/guest/login.html","destination":"/src/pages/auth/login.html"},
    {"source":"/src/pages/guest/register.html","destination":"/src/pages/auth/register.html"},
    {"source":"/src/pages/guest/manager.html","destination":"/src/pages/manager/manager.html"},
    {"source":"/src/pages/guest/manager-demo.html","destination":"/src/pages/manager/manager-demo.html"},
    {"source":"/src/pages/guest/demo-staff.html","destination":"/src/pages/staff/demo-staff.html"},
    {"source":"/src/pages/auth/menu.html","destination":"/src/pages/guest/menu.html"},
    {"source":"/src/pages/guest/cook.html","destination":"/src/pages/staff/cook.html"},
    {"source":"/src/pages/guest/courier.html","destination":"/src/pages/staff/courier.html"},
    {"source":"/src/pages/guest/waiter.html","destination":"/src/pages/staff/waiter.html"}
  ],
  "headers": [
    {"source":"/sw.js","headers":[{"key":"Cache-Control","value":"no-store, max-age=0, must-revalidate"}]},
    {"source":"/src/pages/staff/cook.html","headers":[{"key":"Cache-Control","value":"no-store, max-age=0"}]},
    {"source":"/src/pages/staff/waiter.html","headers":[{"key":"Cache-Control","value":"no-store, max-age=0"}]},
    {"source":"/src/pages/staff/courier.html","headers":[{"key":"Cache-Control","value":"no-store, max-age=0"}]},
    {"source":"/src/pages/manager/manager.html","headers":[{"key":"Cache-Control","value":"no-store, max-age=0"}]},
    {"source":"/src/pages/admin/admin.html","headers":[{"key":"Cache-Control","value":"no-store, max-age=0"}]},
    {"source":"/src/pages/manager/integrations.html","headers":[{"key":"Cache-Control","value":"no-store, max-age=0"}]},
    {"source":"/src/assets/js/shared/config.js","headers":[{"key":"Cache-Control","value":"no-store, max-age=0"}]},
    {"source":"/src/assets/js/manager/manager-site-import.js","headers":[{"key":"Cache-Control","value":"no-store, max-age=0"}]},
    {"source":"/src/assets/js/manager/integrations-hub.js","headers":[{"key":"Cache-Control","value":"no-store, max-age=0"}]}
  ]
}
