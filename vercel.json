{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": ".",
  "git": {"deploymentEnabled":{"main":true}},
  "github": {"enabled":true},
  "crons": [{"path":"/api/cron/integration-sync","schedule":"0 3 * * *"}],
  "functions": {
    "api/admin-ai-agent.js":{"maxDuration":120,"memory":1024},
    "api/admin-ai-isolated.js":{"maxDuration":120,"memory":1024},
    "api/import-site.js":{"maxDuration":60,"memory":1024},
    "api/import-ai.js":{"maxDuration":120,"memory":1024},
    "api/cron.js":{"maxDuration":60,"memory":1024},
    "api/integrations.js":{"maxDuration":60,"memory":1024},
    "api/payments.js":{"maxDuration":60,"memory":1024}
  },
  "rewrites": [
    {"source":"/","destination":"/src/pages/guest/index.html"},
    {"source":"/api/admin-ai-audit","destination":"/api/admin-ai-isolated"},
    {"source":"/api/menu/import","destination":"/api/import-ai"},
    {"source":"/api/manager-ai","destination":"/api/manager-ai-propose"},
    {"source":"/api/integrations/:path*","destination":"/api/integrations?route=/api/integrations/:path*"},
    {"source":"/api/payments/yookassa/:path*","destination":"/api/payments"},
    {"source":"/api/cron/integration-sync","destination":"/api/cron"},
    {"source":"/recipe-images/:slug*","destination":"https://theunitools.com/recipes/:slug*"},
    {"source":"/assets/:path*","destination":"/src/assets/:path*"},
    {"source":"/icons/:path*","destination":"/src/assets/icons/:path*"},
    {"source":"/img/:path*","destination":"/src/assets/img/:path*"},
    {"source":"/css/:path*","destination":"/src/assets/css/:path*"},
    {"source":"/js/:path*","destination":"/src/assets/js/:path*"},
    {"source":"/icon-courier-192.png","destination":"/src/assets/icons/icon-courier-192.png"},
    {"source":"/icon-courier-512.png","destination":"/src/assets/icons/icon-courier-512.png"},
    {"source":"/icon-manager-192.png","destination":"/src/assets/icons/icon-manager-192.png"},
    {"source":"/icon-manager-512.png","destination":"/src/assets/icons/icon-manager-512.png"},
    {"source":"/icon-waiter-192.png","destination":"/src/assets/icons/icon-waiter-192.png"},
    {"source":"/icon-waiter-512.png","destination":"/src/assets/icons/icon-waiter-512.png"},
    {"source":"/apple-touch-icon-courier.png","destination":"/src/assets/icons/apple-touch-icon-courier.png"},
    {"source":"/apple-touch-icon-manager.png","destination":"/src/assets/icons/apple-touch-icon-manager.png"},
    {"source":"/apple-touch-icon-waiter.png","destination":"/src/assets/icons/apple-touch-icon-waiter.png"},
    {"source":"/src/pages/:role/js/:path*","destination":"/src/assets/js/:path*"},
    {"source":"/src/pages/:role/css/:path*","destination":"/src/assets/css/:path*"},
    {"source":"/src/pages/:role/img/:path*","destination":"/src/assets/img/:path*"},
    {"source":"/src/pages/:role/icons/:path*","destination":"/src/assets/icons/:path*"},
    {"source":"/src/pages/guest/login.html","destination":"/src/pages/auth/login.html"},
    {"source":"/src/pages/guest/register.html","destination":"/src/pages/auth/register.html"},
    {"source":"/src/pages/guest/manager.html","destination":"/src/pages/manager/manager.html"},
    {"source":"/src/pages/guest/manager-demo.html","destination":"/src/pages/manager/manager-demo.html"},
    {"source":"/src/pages/auth/menu.html","destination":"/src/pages/guest/menu.html"},
    {"source":"/src/pages/guest/cook.html","destination":"/src/pages/staff/cook.html"},
    {"source":"/src/pages/guest/courier.html","destination":"/src/pages/staff/courier.html"},
    {"source":"/src/pages/guest/waiter.html","destination":"/src/pages/staff/waiter.html"}
  ],
  "headers": [
    {"source":"/src/pages/staff/cook.html","headers":[{"key":"Cache-Control","value":"no-store, max-age=0"}]},
    {"source":"/src/pages/staff/waiter.html","headers":[{"key":"Cache-Control","value":"no-store, max-age=0"}]},
    {"source":"/src/pages/staff/courier.html","headers":[{"key":"Cache-Control","value":"no-store, max-age=0"}]},
    {"source":"/src/pages/manager/manager.html","headers":[{"key":"Cache-Control","value":"no-store, max-age=0"}]},
    {"source":"/src/pages/admin/admin.html","headers":[{"key":"Cache-Control","value":"no-store, max-age=0"}]},
    {"source":"/src/pages/manager/integrations.html","headers":[{"key":"Cache-Control","value":"no-store, max-age=0"}]},
    {"source":"/src/assets/js/shared/config.js","headers":[{"key":"Cache-Control","value":"no-store, max-age=0"}]},
    {"source":"/src/assets/js/manager/manager-site-import.js","headers":[{"key":"Cache-Control","value":"no-store, max-age=0"}]},
    {"source":"/src/assets/js/manager/integrations-hub.js","headers":[{"key":"Cache-Control","value":"no-store, max-age=0"}]}
  ]
}
