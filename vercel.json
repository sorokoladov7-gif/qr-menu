{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "main": true
    }
  },
  "github": {
    "enabled": true
  },
  "functions": {
    "api/import-site.js": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/import-ai.js": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/api/menu/import",
      "destination": "/api/import-ai"
    },
    {
      "source": "/recipe-images/:slug*",
      "destination": "https://theunitools.com/recipes/:slug*"
    }
  ],
  "headers": [
    {
      "source": "/(cook|waiter|courier|manager|admin)\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    },
    {
      "source": "/js/config\\.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    },
    {
      "source": "/js/manager-site-import\\.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    }
  ]
}
