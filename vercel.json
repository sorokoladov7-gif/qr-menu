{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "main": true
    }
  },
  "github": {
    "enabled": true
  },
  "headers": [
    {
      "source": "/(cook|waiter|courier|manager|admin)\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    },
    {
      "source": "/js/config\\.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    },
    {
      "source": "/js/manager-site-import\\.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0"
        }
      ]
    }
  ]
}
